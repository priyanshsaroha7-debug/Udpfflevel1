# ============================================================================
# TEAM 84FF - Multi-Account Web Dashboard Environment Variables (.env.example)
# Copy this file to `.env` and customize values before production deployment.
# ============================================================================

# --- Administrator Authentication ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword!2026
SESSION_EXPIRE_HOURS=24

# --- Cryptographic Keys (Auto-generated if left blank) ---
# SECRET_KEY: 64-char hex string for HMAC-SHA256 session signing
SECRET_KEY=
# FERNET_KEY: 32-byte URL-safe base64 key for encrypting account passwords at rest
FERNET_KEY=

# --- Server & Persistence Paths ---
HOST=0.0.0.0
PORT=7723
DATABASE_PATH=data/dashboard.db
DEVICES_FILE_PATH=data/devices.json
DEFAULT_ACCOUNT_REGION=ME

# --- Protocol & Encryption Settings (Used by lv.py) ---
FF_AES_KEY=Yg&tc%DEuh6%Zc^8
FF_AES_IV=6oyZDr22E3ychjM%
GARENA_CLIENT_ID=100067
GARENA_CLIENT_SECRET=2ee44819e9b4598845141067b281621874d0d5d7af9d8f7e00c1e54715b7d1e3
